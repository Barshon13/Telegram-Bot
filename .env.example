# ==============================================================================
# Environment Configuration for OmniMedia Telegram Bot
# Copy this file to .env and replace placeholder values with your real credentials
# ==============================================================================

# Telegram Bot Token (Obtain from @BotFather on Telegram)
BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz1234567890"

# Google AI Studio API Key (Obtain from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Gemini Model Selection (Recommended: gemini-2.5-flash for speed & low latency)
GEMINI_MODEL="gemini-2.5-flash"

# Monetization 1: Force Subscription Gate Settings
# Note: The bot MUST be added as an Administrator in this channel with "Invite Users via Link" rights
FORCE_CHANNEL_ID="-1001987654321"
FORCE_CHANNEL_USERNAME="YourChannelUsername"
FORCE_CHANNEL_INVITE_LINK="https://t.me/YourChannelUsername"

# Monetization 2: Sponsored Affiliate Footer Settings
# Injected into media download captions and AI responses
SPONSOR_TEXT="🔥 Join VIP Signals & Crypto Alpha"
SPONSOR_URL="https://t.me/YourChannelUsername"

# BotKeep Container Resource & Rate Limit Optimization
# Strict 50MB ceiling to prevent Telegram API rejects and container disk thrashing
MAX_FILE_SIZE_MB=50

# Worker thread concurrency limit (Recommended: 2 for 2GB RAM container to prevent OOM)
MAX_CONCURRENT_DOWNLOADS=2

# Bot Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL="INFO"
